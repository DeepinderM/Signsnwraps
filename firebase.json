{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true
    }
  },
  "apphosting": [
    {
      "backendId": "signsnwraps-web",
      "rootDir": "/",
      "ignore": [
        "node_modules",
        ".git",
        ".next",
        ".firebase",
        ".emulator-data",
        ".env.local",
        ".env.*.local",
        "firebase-debug.log",
        "firestore-debug.log",
        "ui-debug.log",
        "docs",
        "tsconfig.tsbuildinfo"
      ]
    }
  ]
}
