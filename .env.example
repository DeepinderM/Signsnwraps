# Copy to .env.local for local development. Never commit real keys.

# Public canonical URL used for metadata, structured data and Stripe redirects.
# Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://signsnwraps.com.au

# Firebase web app config (Firebase console → Project settings → Your apps). Public values.
# On App Hosting these are filled in automatically from FIREBASE_WEBAPP_CONFIG.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# Local development only: the browser uploads form attachments to the Storage emulator.
# NEXT_PUBLIC_FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Server credentials for local development (not needed on App Hosting). Either:
#  - run `gcloud auth application-default login`, or
#  - paste a service account key JSON on one line:
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# Google accounts allowed into /admin (comma-separated).
ADMIN_EMAILS=

# Optional: email new booking/quote requests here (needs the "Trigger Email from Firestore" extension).
ENQUIRY_NOTIFY_EMAIL=

# Customer emails sent from the admin portal (SMTP). Google Workspace: smtp.gmail.com, port 465,
# your full address as SMTP_USER and an App Password (Google Account → Security → App passwords) as SMTP_PASS.
# Microsoft 365: smtp.office365.com, port 587. Without these, development prints emails to the server log.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Sender shown to customers, e.g. Signsnwraps <hello@signsnwraps.com.au>. Defaults to SMTP_USER.
EMAIL_FROM=
# Optional shared inbox for replies; otherwise replies go to the staff member who sent the email.
EMAIL_REPLY_TO=

# Stripe (Dashboard → Developers → API keys). Use test keys (sk_test_...) until launch.
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` locally,
# or the webhook endpoint's signing secret in production.
STRIPE_WEBHOOK_SECRET=

# Add secure server-side Odoo credentials only when integration is implemented.
# ODOO_BASE_URL=
# ODOO_DATABASE=
# ODOO_USERNAME=
# ODOO_API_KEY=
